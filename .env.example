# Copy to .env and fill in your own values. Never commit .env.

# Twilio account
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+10000000000

# Twilio API key pair + TwiML App (browser softphone via Voice SDK)
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_twilio_api_secret
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook signature validation (keep true; set false only for local tests without Twilio)
TWILIO_VALIDATE_SIGNATURE=true

# Speech (STT + TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Knowledge base
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=voice-agent-docs

# LLM + embeddings
GEMINI_API_KEY=your_gemini_api_key
